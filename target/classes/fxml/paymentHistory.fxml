<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.lifesystem.controllers.PaymentHistoryController"
      spacing="0"
      style="-fx-background-color: #F0F4F8;">

    <!-- Header -->
    <HBox style="-fx-background-color: #8E44AD;
                 -fx-padding: 14 20;"
          alignment="CENTER_LEFT">
        <Label fx:id="lblTenantName"
               text="📋  Payment History"
               style="-fx-font-size: 16;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>
    </HBox>

    <!-- Summary Bar -->
    <HBox style="-fx-background-color: white;
                 -fx-padding: 10 20;
                 -fx-border-color: #E0E0E0;
                 -fx-border-width: 0 0 1 0;"
          spacing="30" alignment="CENTER_LEFT">
        <Label fx:id="lblTotalPaid"
               text="Total Paid: UGX 0"
               style="-fx-font-size: 13;
                      -fx-font-weight: bold;
                      -fx-text-fill: #27AE60;"/>
        <Label fx:id="lblPaymentCount"
               text="Payments: 0"
               style="-fx-font-size: 13;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1C4E80;"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="tblHistory"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colReceipt"
                         text="Receipt No"
                         prefWidth="120"/>
            <TableColumn fx:id="colDate"
                         text="Date Paid"
                         prefWidth="110"/>
            <TableColumn fx:id="colPeriod"
                         text="Period"
                         prefWidth="130"/>
            <TableColumn fx:id="colAmount"
                         text="Amount (UGX)"
                         prefWidth="130"/>
            <TableColumn fx:id="colMethod"
                         text="Method"
                         prefWidth="110"/>
            <TableColumn fx:id="colNotes"
                         text="Notes"
                         prefWidth="140"/>
        </columns>
        <placeholder>
            <Label text="No payments recorded yet."
                   style="-fx-text-fill: #999;"/>
        </placeholder>
    </TableView>

    <!-- Close Button -->
    <HBox alignment="CENTER"
          style="-fx-padding: 12;">
        <Button text="Close"
                onAction="#handleClose"
                prefWidth="120"
                prefHeight="36"
                style="-fx-background-color: #C0392B;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>
    </HBox>

</VBox>